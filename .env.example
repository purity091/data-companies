# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase-only runtime configuration.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."

# Browser aliases used by the Supabase SSR helpers.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# TrustMRR import credentials (server-only; never prefix these with NEXT_PUBLIC_).
TRUSTMRR_API_KEY="tmrr_your_api_key"
TRUSTMRR_IMPORT_TOKEN="your_internal_import_token"
CRON_SECRET="your_random_cron_secret"

# Local-only preview mode. Uses TypeScript in-memory fixtures and does not persist data.
PREVIEW_MODE="false"
NEXT_PUBLIC_SUPABASE_URL=https://hcrocpssrskydpmmrruw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_eFn4ELVSnGzmhReEyMxY0g_EDDXbyxf
TRUSTMRR_API_KEY=tmrr_7623edf220060e24d3963d9aa80df292

PREVIEW_MODE=false
